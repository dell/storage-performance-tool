# Harbor Registry Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to git!

# Harbor Registry Settings
DOCKER_REGISTRY=dcr.octo.dell.com
DOCKER_NAMESPACE=spt

# Harbor Robot Account Credentials
# Format: robot$projectname+robotname
HARBOR_ROBOT_USER=robot$spt+YOUR_ROBOT_NAME
HARBOR_ROBOT_TOKEN=YOUR_ROBOT_TOKEN_HERE

# Alternative: Use personal account (not recommended for CI/CD)
# HARBOR_USER=your-username
# HARBOR_CLI_SECRET=your-cli-secret