# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Environment files (contains credentials)
.env
.env.local
.env.*.local

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# VS Code
.vscode/

# macOS
.DS_Store

# Spt specific
/logs/
/spt-*.log
/test-output/
/target/
*.tmp

# Prevent accidental commits of stray log directories created when
# Log4j context variables are unset (e.g., running tests/tools without Main).
# These literal directory names only appear on misconfigured runs.
**/${ctx:home_dir}/
**/${ctx:step_id}/

# Maven (in case of migration)
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Temp files
tmp/

# Local helper scripts
tools/legacy-docker-publish.sh
