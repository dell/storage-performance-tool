#!/bin/sh
#
# Prints this host's NIC inventory and, with --interfaces, the NIC plan, as JSON on stdout.
# spt verify runs it in the node container it starts on each host:
#   docker exec <node container> /opt/spt/spt-nic-plan --interfaces auto --endpoint <host:port> ...
# Run --help for the arguments. Exit codes: 0 output produced, 2 usage error, 1 internal error.
#
# The JVM is kept small: no pre-touched heap, no ZGC. UseAVX=2 matches the entrypoint on x86-64.
# Native access is enabled so loading the s3-rdma library under --rdma prints no JVM warning.
set -eu

JAVA_OPTS="-Xmx256m -XX:+UseSerialGC -Xshare:off --enable-native-access=ALL-UNNAMED"
case "$(uname -m)" in
	x86_64) JAVA_OPTS="${JAVA_OPTS} -XX:UseAVX=2" ;;
esac

# shellcheck disable=SC2086 # JAVA_OPTS is a list of options
exec java ${JAVA_OPTS} -cp /opt/spt/spt.jar com.dell.spt.base.nic.NicPlanCommand "$@"
