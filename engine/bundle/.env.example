# Spt S3 Configuration Example
# 
# Copy this file to .env and update with your actual values
# DO NOT commit the .env file to version control
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env
#   make docker-compose-run

# S3-compatible endpoint (without http:// prefix)
SPT_S3_ENDPOINT=your-s3-endpoint:9000

# S3 access credentials
SPT_S3_ACCESS_KEY=your-access-key
SPT_S3_SECRET_KEY=your-secret-key

# Target bucket name
SPT_S3_BUCKET=your-bucket-name

# Optional: JVM options for a container started with --env-file .env. They are added after the
# image's defaults, and when an option is given twice the JVM uses the later one. docker-compose.yml
# doesn't read this value.
JAVA_OPTS=-Xmx8g
