{
  "name": "spt-dashboard",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "preview": "vite preview",
    "format": "prettier --write src scripts README.md",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "echarts": "6.1.0",
    "lucide-react": "1.65.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
